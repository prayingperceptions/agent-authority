{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prayingperceptions/agent-authority/blob/main/schemas/passport.schema.json",
  "title": "Agent Passport v0.1",
  "type": "object",
  "required": ["version", "passportId", "agentId", "issuer", "subject", "createdAt", "publicKeyJwk"],
  "properties": {
    "version": { "const": "0.1" },
    "passportId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "publicKeyJwk": {
      "type": "object",
      "required": ["kty", "crv", "x"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "Ed25519" },
        "x": { "type": "string" }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}

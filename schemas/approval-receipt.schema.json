{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-authority.dev/schemas/approval-receipt-v1.schema.json",
  "title": "Agent Authority Approval Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "approvalId",
    "eventId",
    "contractId",
    "agentId",
    "approvedBy",
    "approvedAt",
    "decision",
    "actionDigest"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reason": {
      "type": "string"
    },
    "actionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
